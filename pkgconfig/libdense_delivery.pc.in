prefix=@PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@LIBDIR@
includedir=${prefix}/include/dense

Name: libdense_delivery
Description: Explicitly owned publications and Linux delivery workers
Version: @VERSION@
Libs: -L${libdir} -ldense_delivery -ldense_net -ldense_sim
Libs.private: -pthread -lm
Cflags: -I${includedir} -pthread
